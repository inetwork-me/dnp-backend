# ===================================================================
# MPGS (MASTERCARD PAYMENT GATEWAY SERVICES) CONFIGURATION
# ===================================================================
# Add these variables to your .env file

MPGS_USE_TEST=true
MPGS_API_VERSION=100

# --- PRODUCTION CREDENTIALS (LIVE) ---
MPGS_PROD_MERCHANT_ID=CIB701947
MPGS_PROD_USERNAME=merchant.CIB701947
MPGS_PROD_PASSWORD=your_production_password_here
MPGS_PROD_API_URL=https://cibpaynow.gateway.mastercard.com

# --- TEST CREDENTIALS (DEVELOPMENT/STAGING) ---
MPGS_TEST_MERCHANT_ID=TEST_MERCHANT_ID
MPGS_TEST_USERNAME=merchant.TEST_MERCHANT_ID
MPGS_TEST_PASSWORD=test_password_here
MPGS_TEST_API_URL=https://test-cibpaynow.gateway.mastercard.com

# --- FRONTEND URL FOR PAYMENT REDIRECTS ---
FRONTEND_URL=http://localhost:3000

# ===================================================================
# INSTRUCTIONS:
# ===================================================================
# 1. Copy these variables to your .env file
# 2. Fill in your actual MPGS credentials from CIB Bank
# 3. Set MPGS_USE_TEST=true for development
# 4. Set MPGS_USE_TEST=false for production
# 5. Update FRONTEND_URL to your production domain in production
# ===================================================================
